#--------------------------------------------------------------------
# JWT — AITessera 토큰 검증 (RS256 비대칭키 전환)
#--------------------------------------------------------------------
# 검증 허용 알고리즘. 전환기에는 두 알고리즘을 모두 허용하고, AITessera 가
# RS256 로 완전 전환 + 기존 HS256 토큰 만료 후 'RS256' 으로 좁힌다.
JWT_VERIFY_ALGOS = 'HS256,RS256'

# HS256 검증용 공유 시크릿(전환기 한정 — 32자 이상, AITessera 서명키와 동일 값).
# JWT_VERIFY_ALGOS 에서 HS256 제거 시 불필요.
JWT_SECRET = 'change-me-to-a-random-32+-char-secret'

# RS256 검증용 AITessera 공개키(PEM) 파일 경로. AITessera 의 `jwt:keygen` 으로
# 생성된 공개키만 배치한다(개인키는 절대 배치 금지).
# JWT_PUBLIC_KEY_PATH = 'writable/keys/aitessera_public.pem'

#--------------------------------------------------------------------
# 자체 발급 토큰 (플로팅 라이센스 활성화 등 — HS256)
#--------------------------------------------------------------------
# AILicet 이 발급·검증을 모두 담당하는 내부 토큰용 시크릿(32자 이상).
# 미설정 시 JWT_SECRET 으로 폴백한다.
# LICENSE_TOKEN_SECRET =

#--------------------------------------------------------------------
# AITessera (회원 인증 서비스)
#--------------------------------------------------------------------
# 설정 시 로그인은 AITessera 로그인 API로 위임된다.
# 미설정 + development 환경이면 UI 확인용 데모 로그인이 활성화된다.
# aitessera.baseURL = 'http://localhost:8400'

#--------------------------------------------------------------------
# 라이센스 서명 (노드락 — Ed25519)
#--------------------------------------------------------------------
# `php spark license:keygen` 으로 생성. 개인키는 절대 커밋 금지(운영은 KMS/Secrets Manager).
# license.ed25519PublicKey =
# license.ed25519SecretKey =
# license.deployTarget = 'dev'          # 저장 경로 접두(dev/stg/prd)
# license.storageDriver = 'local'       # local | s3

