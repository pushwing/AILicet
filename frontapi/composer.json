{
    "name": "aivance/ailicet-frontapi",
    "description": "AILicet frontApi — 클라이언트 프로그램용 라이선스 인증 API (pure PHP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.2",
        "psr/http-server-middleware": "^1.0",
        "relay/relay": "^2.1",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Routes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-di/invoker": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
