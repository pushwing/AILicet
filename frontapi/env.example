# frontApi 환경 설정 예시. 복사: cp env.example .env
APP_ENV=production

# DB (CI4 앱과 동일 DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ailicet
DB_USER=ailicet
DB_PASS=

# JWT (AITessera 서명키와 동일 값 공유)
JWT_SECRET=

# Redis (Rate Limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# 노드락 서명 공개키(CI4 발급 엔진과 동일 키페어의 공개키, base64)
LICENSE_ED25519_PUBLIC_KEY=
# 사용정보 원시 로그 경로
RAW_LOG_PATH=./var/logs/raw
